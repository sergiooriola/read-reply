#!/bin/sh
# Runs the project's checks before every push, in place of a CI.
# Enable it once per clone: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"

# The checks read the working tree, so it must match the commit being pushed.
if ! git diff --quiet HEAD --; then
  echo "pre-push: hay cambios sin commit; haz commit o guárdalos antes de subir." >&2
  exit 1
fi

exec scripts/check
