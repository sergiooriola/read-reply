#!/usr/bin/env bash
# Installs the read-reply command, or reinstalls it after a change, with the
# exact dependency versions of uv.lock: `uv tool install` on its own reads
# neither the lockfile nor the project's settings, such as exclude-newer.
# --locked stops it when uv.lock no longer matches pyproject.toml.
set -euo pipefail
cd "$(dirname "$0")/.."

constraints=$(mktemp)
trap 'rm -f "$constraints"' EXIT
uv export --locked --no-dev --no-emit-project --no-hashes --quiet \
  --output-file "$constraints"
uv tool install --reinstall --constraints "$constraints" .
